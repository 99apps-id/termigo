[Unit]
Description=Termigo Headless AI Telegram Relay
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/termigo
ExecStart=/opt/termigo/scripts/run-headless.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
# Measured working set of one ordinary agent run on a session with long history:
# ~2.6GB, and it grows with the transcript. The first attempt at a ceiling
# (MemoryHigh=2560M) sat exactly AT that working set, so the kernel throttled the
# app 25,000 times and the webview stayed slow. The soft limit has to sit clearly
# above the working set to stop the throttling, so it is 3072M here; MemoryMax
# stays as a real guard, and the 512M band between them is the slow-down zone
# before a kill.
#
# Termigo holds no swap of its own (the box's swap pressure is other tenants),
# so raising the soft limit costs the host nothing but a ceiling it never had.
MemoryHigh=3072M
MemoryMax=3584M

[Install]
WantedBy=multi-user.target
