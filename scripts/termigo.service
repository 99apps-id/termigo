[Unit]
Description=Termigo Headless AI Telegram Relay
After=network.target

[Service]
Type=simple
User=admin
WorkingDirectory=/opt/termigo
ExecStart=/opt/termigo/scripts/run-headless.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536
# Measured on the field install: a single ordinary agent run on a session with
# long history peaks at 1.9-2.1GB, and the old MemoryHigh=2G sat below that, so
# the webview was throttled until it stopped answering and the relay went silent.
# The headroom here is what keeps a normal run below the throttle point.
MemoryHigh=2560M
MemoryMax=3072M

[Install]
WantedBy=multi-user.target
