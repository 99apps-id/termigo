[
  {
    "name": "main window startup JS (eager modulepreload)",
    "path": [
      "dist/assets/main-*.js",
      "dist/assets/react-*.js",
      "dist/assets/radix-*.js",
      "dist/assets/alert-dialog-*.js",
      "dist/assets/xterm-*.js"
    ],
    "limit": "540 KB",
    "gzip": true
  },
  {
    "name": "total client JS (all lazy chunks, never loaded at once)",
    "path": ["dist/assets/*.js"],
    "limit": "4.25 MB",
    "gzip": true
  },
  {
    "name": "total client bundle (JS, CSS, HTML and fonts shipped to the webview)",
    "path": ["dist/**/*"],
    "limit": "4.6 MB",
    "gzip": true
  }
]
